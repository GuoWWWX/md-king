{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-king",
  "version": "0.1.0",
  "identifier": "com.mdking.app",
  "build": {
    "beforeDevCommand": "node ensure-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "md-king",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/pandoc/windows/pandoc.exe": "pandoc/windows/pandoc.exe",
      "resources/templates/default-report/reference.docx": "templates/default-report/reference.docx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
