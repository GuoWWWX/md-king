{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-king",
  "version": "1.1.8",
  "identifier": "com.mdking.app",
  "build": {
    "beforeDevCommand": "node ensure-dev-server.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "md-king",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": true,
        "backgroundColor": "#00000000",
        "decorations": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/pandoc/windows/pandoc.exe": "pandoc/windows/pandoc.exe",
      "resources/templates/default-report/reference.docx": "templates/default-report/reference.docx"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "uninstallerHeaderImage": "icons/nsis-header.bmp"
      },
      "wix": {
        "bannerPath": "icons/wix-banner.bmp",
        "dialogImagePath": "icons/wix-dialog.bmp"
      }
    }
  }
}
