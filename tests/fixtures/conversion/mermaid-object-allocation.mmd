flowchart TD
    A["执行 new 指令"] --> B{"1. 类加载检查\n(常量池能否定位到符号引用？该类是否已加载？)"}
    B -- "未加载" --> C["触发类加载流程 (加载-验证-准备-解析-初始化)"]
    B -- "已加载" --> D["2. 划分内存空间 (计算对象精确大小)"]
    C --> D
    D --> E{"堆空间是否绝对规整？"}
    E -- "规整 (标记-复制/整理)" --> F["指针碰撞 (Bump the Pointer)"]
    E -- "不规整 (标记-清除)" --> G["空闲列表 (Free List)"]
    F & G --> H{"高并发分配如何保证线程安全？"}
    H -- "默认开启 TLAB" --> I["TLAB 线程独享分配 (无锁极速)"]
    H -- "TLAB 用完或未开" --> J["CAS 失败重试原子分配"]
    I & J --> K["3. 内存空间零值初始化\n(默认清零，保证成员变量不赋初值即可用)"]
    K --> L["4. 设置对象头 (Object Header)\n(写入 Mark Word、元数据指针 Klass Word、分代年龄)"]
    L --> M["5. 执行构造方法 <init>\n(程序员编写的字段赋值与构造函数逻辑)"]
    M --> N["6. 栈上局部变量表获得对象引用指针"]
